{
  "name": "sieve",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test.js",
    "vendor": "node vendor.mjs",
    "dev": "npm run vendor && web-ext run",
    "sign": "npm run clean && npm run vendor && web-ext sign --channel=unlisted",
    "release": "node release.mjs",
    "build": "npm run clean && npm run vendor && web-ext build",
    "clean": "node -e \"require('fs').rmSync('web-ext-artifacts',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "web-ext": "^10.6.0"
  }
}
