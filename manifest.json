{
  "name": "sieve",
  "version": "0.2.1",
  "manifest_version": 2,
  "description": "Hides posts you'd hide, learned from the image and the text together.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "<all_urls>"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://boards.4chan.org/*",
        "*://old.reddit.com/*"
      ],
      "js": ["sites.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg"
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "sieve — settings and close calls"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sieve@example.com",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/softmix/sieve/master/updates.json",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
